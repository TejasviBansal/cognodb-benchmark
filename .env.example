COGNODB_URI=bolt+s://your-instance-id.databases.cognodb.cloud:7687
COGNODB_USER=cognodb
COGNODB_PASSWORD=your-password-here

NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USER=your-username
NEO4J_PASSWORD=your-password-here

MEMGRAPH_URI=bolt+ssc://your-instance-ip:7687
MEMGRAPH_USER=your-email@example.com
MEMGRAPH_PASSWORD=your-password-here

ARANGO_URI=https://your-instance-id.arangodb.cloud:8529
ARANGO_USER=root
ARANGO_PASSWORD=your-password-here